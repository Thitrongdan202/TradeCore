# ─── Database ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

DATABASE_URL=postgresql+psycopg2://tradecore:tradecore_dev_pw@localhost:5432/tradecore
ASYNC_DATABASE_URL=postgresql+asyncpg://tradecore:tradecore_dev_pw@localhost:5432/tradecore

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-32-random-chars

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-64-random-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Pagination ────────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
